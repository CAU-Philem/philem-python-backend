# philem-python-backend에서 .env파일 만들고 밑의 형식에 따라 정보 기입

# ==== OpenAI ====
# Comma-separated list of keys: "sk-1,sk-2,sk-3"
OPENAI_API_KEYS=

# ==== SSH (for RDS tunneling) ====
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=

# ==== Database (RDS) ====
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ==== Optional: App env flags ====
APP_ENV=local
